; Engine configuration file.
; Widescreen presentation; combat_host keeps the original 540 x 900 arena.
config_version=5

[application]

config/name="catsSaga()"
run/main_scene="res://scenes/main_menu.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

; Gameplay reads keys directly in scenes/player.gd; no custom InputMap actions
; are required. Keep the engine's built-in UI actions for menu navigation.

window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[autoload]

Session="*res://scripts/systems/session.gd"
